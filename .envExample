ENCRYPTION_KEY=your-32-character-key-here...  create with CLI: "openssl rand -hex 16"
ENCRYPTION_IV=your-16-character-iv-here... CLI: "openssl rand -hex 8"

# Payment Configuration
NEXT_PUBLIC_V3RA_WALLET_PUBLIC_KEY=your_solana_public_key_here # Where user SOL payments go
V3RA_WALLET_PUBLIC_KEY=your_solana_public_key_here # Backend wallet address (same as above)

# v3ra Configuration
# 1. Create a new Supabase project at https://supabase.com
# 2. Update the DATABASE_URL and PRISMA_DATABASE_URL with your Supabase credentials
# 3. Generate new encryption keys for security:
#    - ENCRYPTION_KEY: openssl rand -hex 16
#    - ENCRYPTION_IV: openssl rand -hex 8
# 4. Add your AI provider API keys above
# 5. Set your Solana payment receiver address