generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model ApiKey {
  id           String         @id @default(dbgenerated("uuid_generate_v4()"))
  name         String
  provider     String
  key          String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  lastUsed     DateTime?
  ValidatorKey ValidatorKey[]

  @@index([provider, isActive])
  @@index([provider, isActive], map: "idx_api_key_provider")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Favorite {
  id              String      @id @db.Uuid
  user_id         String      @db.Uuid
  vote_session_id String
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  favoriteType    String?
  title           String?
  VoteSession     VoteSession @relation(fields: [vote_session_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vote_session_id])
  @@index([user_id])
}

model Feedback {
  id                 String   @id
  userId             String
  username           String
  email              String
  rating             String   @default("thumbs_up")
  explanation        String?
  options            String[] @default([])
  includeBrowserInfo Boolean  @default(true)
  browserInfo        Json?
  url                String
  component          String
  action             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  title              String?
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model GraphEdge {
  id            String       @id
  sourceType    String
  targetType    String
  sourceId      String
  targetId      String
  relationship  String
  weight        Float?
  properties    String       @default("")
  createdAt     DateTime     @default(now())
  validatorId   String?
  voteSessionId String?
  Validator     Validator?   @relation(fields: [validatorId], references: [id], onDelete: Cascade)
  VoteSession   VoteSession? @relation(fields: [voteSessionId], references: [id])

  @@index([relationship])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

model LLMHealthMetric {
  id               String          @id
  providerName     String          @db.VarChar(50)
  modelName        String          @db.VarChar(100)
  status           LLMHealthStatus @default(healthy)
  errorRate        Decimal?        @db.Decimal(5, 2)
  avgLatency       Int?
  successRate      Decimal?        @db.Decimal(5, 2)
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  totalRequests    Int             @default(0)
  failedRequests   Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime

  @@unique([providerName, modelName])
  @@index([createdAt])
  @@index([providerName, modelName])
  @@index([status])
}

model LLMHealthProbe {
  id             String   @id
  providerName   String   @db.VarChar(50)
  modelName      String   @db.VarChar(100)
  probeType      String   @db.VarChar(50)
  success        Boolean
  responseTimeMs Int?
  errorMessage   String?
  httpStatus     Int?
  testedAt       DateTime @default(now())

  @@index([providerName, modelName])
  @@index([success])
  @@index([testedAt])
}

model ModelDeprecationAlert {
  id                 String    @id
  modelName          String    @db.VarChar(100)
  providerName       String    @db.VarChar(50)
  deprecatedAt       DateTime
  replacementModel   String?   @db.VarChar(100)
  alertSent          Boolean   @default(false)
  resolvedAt         DateTime?
  errorSample        String?
  affectedValidators Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime

  @@index([alertSent])
  @@index([providerName, modelName])
  @@index([resolvedAt])
}

model PaymentLog {
  id              String   @id
  walletPublicKey String
  credits         Int
  solAmount       Float?
  otherAmount     Float?
  otherPayType    String?
  status          String
  error           String?
  createdAt       DateTime @default(now())
}

model Reply {
  id        String   @id
  body      String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  threadId  String
  Thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Thread {
  id            String      @id
  title         String
  body          String
  upvotes       Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  voteSessionId String
  downvotes     Int         @default(0)
  Reply         Reply[]
  VoteSession   VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id            String      @id
  email         String      @unique
  name          String
  userCreditId  String?     @unique
  freeCredits   Int         @default(10)
  lastResetDate DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Feedback      Feedback[]
  UserCredit    UserCredit?
}

model UserCredit {
  id              String        @id
  walletPublicKey String        @unique
  credits         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  userId          String?       @unique
  User            User?         @relation(fields: [userId], references: [id])
  VoteSession     VoteSession[]
}

model Validator {
  id                String              @id
  profileName       String
  provider          String
  modelName         String
  publicKey         String
  isLeader          Boolean             @default(false)
  active            Boolean             @default(true)
  description       String?
  avatarUrl         String?
  validatorType     String?
  reliability       Float?              @default(0.0)
  totalVotes        Int                 @default(0)
  correctVotes      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  GraphEdge         GraphEdge[]
  ValidatorKey      ValidatorKey[]
  ValidatorResponse ValidatorResponse[]

  @@index([active])
  @@index([provider])
  @@index([active, provider], map: "idx_validator_active_provider")
}

model ValidatorKey {
  id          String    @id
  validatorId String
  apiKeyId    String
  createdAt   DateTime  @default(now())
  ApiKey      ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  Validator   Validator @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([validatorId, apiKeyId])
  @@index([validatorId], map: "idx_validator_key_validator")
}

model ValidatorResponse {
  id                 String      @id
  vote               String
  rationale          String
  confidence         Float?      @default(0.5)
  rationaleEmbedding String?
  latency            Int?
  matchedConsensus   Boolean?
  voteSessionId      String
  validatorId        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime
  error              String?
  Validator          Validator   @relation(fields: [validatorId], references: [id], onDelete: Cascade)
  VoteSession        VoteSession @relation(fields: [voteSessionId], references: [id])

  @@index([matchedConsensus])
  @@index([validatorId])
  @@index([voteSessionId])
  @@index([vote])
  @@index([voteSessionId], map: "idx_validator_response_session")
}

model VoteSession {
  id                 String              @id
  queryText          String
  context            String?
  timestamp          DateTime            @default(now())
  isConsensusReached Boolean
  consensusValue     Boolean?
  votesYes           Int                 @default(0)
  votesNo            Int                 @default(0)
  notVoted           Int                 @default(0)
  leaderId           String?
  txHash             String?
  blockchainNetwork  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  mode               QueryMode?
  queryAiCountReq    Int?
  queryCost          Float?
  responseLatency    Int?
  statusProcessing   QueryStatus?
  userId             String?
  walletPublicKey    String?
  Favorite           Favorite[]
  GraphEdge          GraphEdge[]
  Thread             Thread[]
  ValidatorResponse  ValidatorResponse[]
  UserCredit         UserCredit?         @relation(fields: [userId], references: [id])
  Predictions        Prediction[]

  @@index([consensusValue])
  @@index([isConsensusReached])
  @@index([timestamp])
  @@index([timestamp(sort: Desc)], map: "idx_vote_session_timestamp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model credit_audit_log {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  operation      String
  credit_type    String
  amount         Int
  balance_before Int
  balance_after  Int
  reason         String?
  metadata       Json?     @default("{}")
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  created_by     String?   @db.Uuid
  ip_address     String?   @db.Inet
  user_agent     String?

  @@index([created_at], map: "idx_credit_audit_created_at")
  @@index([operation], map: "idx_credit_audit_operation")
  @@index([user_id], map: "idx_credit_audit_user_id")
}

enum LLMHealthStatus {
  healthy
  degraded
  deprecated
  offline
}

enum QueryMode {
  factCheck
  create
  predict
  shop
}

enum QueryStatus {
  Pending
  Voting
  Completed
  Failed
}

enum ResolutionStatus {
  pending
  resolved
  disputed
  unresolvable
}

enum ResolutionMethod {
  automated
  user_verified
  consensus
  official_source
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

model Prediction {
  id                String               @id @default(dbgenerated("gen_random_uuid()"))
  voteSessionId     String?
  queryText         String
  category          String?              @db.VarChar(50)
  createdAt         DateTime             @default(now())
  resolutionDate    DateTime?
  resolutionStatus  ResolutionStatus     @default(pending)
  createdBy         String?              @db.VarChar(100)
  metadata          Json?
  VoteSession       VoteSession?         @relation(fields: [voteSessionId], references: [id])
  outcomes          PredictionOutcome[]
  modelPredictions  ModelPrediction[]
  resolutions       PredictionResolution[]
  verificationVotes VerificationVote[]
  market            PredictionMarket?

  @@index([resolutionStatus])
  @@index([resolutionDate])
  @@index([category])
}

model PredictionOutcome {
  id                  String      @id @default(dbgenerated("gen_random_uuid()"))
  predictionId        String
  outcomeText         String
  consensusProbability Decimal?    @db.Decimal(5, 4)
  modelAgreement      Decimal?    @db.Decimal(5, 4)
  modelCount          Int         @default(0)
  createdAt           DateTime    @default(now())
  Prediction          Prediction  @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId])
}

model ModelPrediction {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  predictionId    String
  modelName       String           @db.VarChar(100)
  outcomeText     String
  probability     Decimal?         @db.Decimal(5, 4)
  confidenceLevel ConfidenceLevel?
  reasoning       String?
  createdAt       DateTime         @default(now())
  Prediction      Prediction       @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId])
}

model PredictionResolution {
  id                 String            @id @default(dbgenerated("gen_random_uuid()"))
  predictionId       String
  actualOutcome      String
  resolvedAt         DateTime          @default(now())
  resolutionMethod   ResolutionMethod?
  verificationSource String?
  evidence           String?
  resolverId         String?           @db.VarChar(100)
  confidenceScore    Decimal?          @db.Decimal(3, 2)
  disputeCount       Int               @default(0)
  Prediction         Prediction        @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([predictionId])
}

model ModelPerformance {
  modelName           String    @db.VarChar(100)
  periodStart         DateTime  @db.Date
  periodEnd           DateTime  @db.Date
  totalPredictions    Int       @default(0)
  accuratePredictions Int       @default(0)
  brierScore          Decimal?  @db.Decimal(5, 4)
  calibrationScore    Decimal?  @db.Decimal(5, 4)
  logScore            Decimal?  @db.Decimal(6, 4)
  category            String    @db.VarChar(50) @default("general")
  metadata            Json?

  @@id([modelName, periodStart, category])
  @@index([periodStart, periodEnd])
}

model VerificationVote {
  id           String     @id @default(dbgenerated("gen_random_uuid()"))
  predictionId String
  userId       String     @db.VarChar(100)
  votedOutcome String
  evidence     String?
  createdAt    DateTime   @default(now())
  Prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@unique([predictionId, userId])
}

// ==================== V3RA Points System ====================

model UserPoints {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  userId       String   @unique
  balance      Decimal  @default(1000.00) @db.Decimal(20, 2)
  totalEarned  Decimal  @default(1000.00) @db.Decimal(20, 2)
  totalSpent   Decimal  @default(0.00) @db.Decimal(20, 2)
  level        Int      @default(1)
  streak       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userId])
}

model PointsTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  userId      String
  type        PointsTransactionType
  amount      Decimal  @db.Decimal(20, 2)
  balance     Decimal  @db.Decimal(20, 2)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  
  @@index([userId])
}

model PredictionMarket {
  id                   String    @id @default(dbgenerated("gen_random_uuid()"))
  predictionId         String    @unique
  creatorId           String
  status              MarketStatus @default(PENDING)
  activationThreshold Decimal   @default(100.00) @db.Decimal(20, 2)
  currentStake        Decimal   @default(0.00) @db.Decimal(20, 2)
  yesPool             Decimal   @default(0.00) @db.Decimal(20, 2)
  noPool              Decimal   @default(0.00) @db.Decimal(20, 2)
  initialProbability  Decimal   @db.Decimal(5, 4)
  currentProbability  Decimal   @db.Decimal(5, 4)
  activatedAt         DateTime?
  resolvedAt          DateTime?
  winningOutcome      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  prediction   Prediction     @relation(fields: [predictionId], references: [id])
  bets         MarketBet[]
  stakes       MarketStake[]
  
  @@index([status])
  @@index([creatorId])
}

model MarketBet {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  marketId        String
  userId          String
  position        BetPosition
  amount          Decimal   @db.Decimal(20, 2)
  odds            Decimal   @db.Decimal(10, 4)
  potentialReturn Decimal   @db.Decimal(20, 2)
  status          BetStatus @default(PENDING)
  settledAt       DateTime?
  payout          Decimal?  @db.Decimal(20, 2)
  createdAt       DateTime  @default(now())
  
  market          PredictionMarket @relation(fields: [marketId], references: [id])
  
  @@index([marketId])
  @@index([userId])
  @@index([status])
}

model MarketStake {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  marketId  String
  userId    String
  amount    Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  
  market    PredictionMarket @relation(fields: [marketId], references: [id])
  
  @@index([marketId])
}

enum PointsTransactionType {
  DAILY_BONUS
  BET_WIN
  BET_LOSS
  MARKET_CREATE
  VERIFICATION_REWARD
  STAKE_REFUND
  INITIAL_GRANT
}

enum MarketStatus {
  PENDING
  ACTIVE
  RESOLVED
  CANCELLED
}

enum BetPosition {
  YES
  NO
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
}
EOF < /dev/null
