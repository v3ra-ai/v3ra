generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueryMode {
  factCheck
  create
  predict
  shop
}

enum QueryStatus {
  Pending
  Voting
  Completed
  Failed
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  userCredit   UserCredit? @relation(name: "UserToUserCredit")
  userCreditId String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  feedbacks    Feedback[]  @relation("UserToFeedback") // Added relation field
}

model UserCredit {
  id              String        @id @default(uuid())
  walletPublicKey String        @unique
  credits         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String?       @unique
  user            User?         @relation(name: "UserToUserCredit", fields: [userId], references: [id], onDelete: SetNull)
  voteSessions    VoteSession[]
}

model PaymentLog {
  id              String   @id
  walletPublicKey String
  credits         Int
  solAmount       Float
  status          String
  error           String?
  createdAt       DateTime @default(now())
}

model ApiKey {
  id            String         @id @default(dbgenerated("uuid_generate_v4()"))
  name          String
  provider      String
  key           String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastUsed      DateTime?
  validatorKeys ValidatorKey[]

  @@index([provider, isActive])
}

model ValidatorKey {
  id          String    @id @default(uuid())
  validatorId String
  apiKeyId    String
  createdAt   DateTime  @default(now())
  apiKey      ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  validator   Validator @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([validatorId, apiKeyId])
}

model Validator {
  id            String              @id @default(uuid())
  profileName   String
  provider      String
  modelName     String
  publicKey     String
  isLeader      Boolean             @default(false)
  active        Boolean             @default(true)
  description   String?
  avatarUrl     String?
  validatorType String?
  reliability   Float?              @default(0.0)
  totalVotes    Int                 @default(0)
  correctVotes  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  graphEdges    GraphEdge[]         @relation("ValidatorEdges")
  apiKeys       ValidatorKey[]
  responses     ValidatorResponse[]

  @@index([provider])
  @@index([active])
}

model VoteSession {
  id                 String              @id @default(uuid())
  queryText          String
  context            String?
  timestamp          DateTime            @default(now())
  isConsensusReached Boolean
  consensusValue     Boolean?
  votesYes           Int                 @default(0)
  votesNo            Int                 @default(0)
  notVoted           Int                 @default(0)
  leaderId           String?
  txHash             String?
  blockchainNetwork  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  graphEdges         GraphEdge[]         @relation("VoteSessionEdges")
  threads            Thread[]
  validatorResponses ValidatorResponse[]
  mode               QueryMode? // Nullable for legacy compatibility
  queryAiCountReq    Int? // Nullable, number of AIs requested
  walletPublicKey    String? // Nullable, wallet key for user
  userId             String? // Nullable, foreign key to UserCredit
  statusProcessing   QueryStatus? // Nullable, query status
  queryCost          Float? // Nullable, cost in credits
  responseLatency    Int? // Nullable, latency in milliseconds
  user               UserCredit?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  favorites          Favorite[]          @relation // Added opposite relation

  @@index([timestamp])
  @@index([consensusValue])
  @@index([isConsensusReached])
}

model ValidatorResponse {
  id                 String      @id @default(uuid())
  vote               String
  rationale          String
  confidence         Float?      @default(0.5)
  rationaleEmbedding String?
  latency            Int?
  matchedConsensus   Boolean?
  voteSessionId      String
  validatorId        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  error              String?
  validator          Validator   @relation(fields: [validatorId], references: [id], onDelete: Cascade)
  voteSession        VoteSession @relation(fields: [voteSessionId], references: [id])

  @@index([vote])
  @@index([voteSessionId])
  @@index([validatorId])
  @@index([matchedConsensus])
}

model GraphEdge {
  id            String       @id @default(uuid())
  sourceType    String
  targetType    String
  sourceId      String
  targetId      String
  relationship  String
  weight        Float?
  properties    String       @default("")
  createdAt     DateTime     @default(now())
  validatorId   String?
  voteSessionId String?
  voteSession   VoteSession? @relation("VoteSessionEdges", fields: [voteSessionId], references: [id])
  validator     Validator?   @relation("ValidatorEdges", fields: [validatorId], references: [id], onDelete: Cascade)

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationship])
}

model Thread {
  id            String      @id @default(uuid())
  title         String
  body          String
  upvotes       Int         @default(0)
  downvotes     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  voteSessionId String
  replies       Reply[]
  voteSession   VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
}

model Reply {
  id        String   @id @default(uuid())
  body      String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Feedback {
  id                 String   @id @default(uuid())
  userId             String
  username           String
  email              String
  rating             String   @default("thumbs_up") // "thumbs_up" or "thumbs_down"
  explanation        String?
  options            String[] @default([]) // e.g., ["slow_response", "error_response", "bad_ui"]
  includeBrowserInfo Boolean  @default(true)
  browserInfo        Json?
  url                String
  component          String
  action             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation("UserToFeedback", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Favorite {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid // Foreign key to auth.users, no relation
  vote_session_id String   // Changed to String (TEXT) to match vote_sessions.id
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  vote_session    VoteSession @relation(fields: [vote_session_id], references: [id], onDelete: Cascade)
  @@unique([user_id, vote_session_id])
  @@index([user_id])
}
