generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  userCreditId  String?     @unique
  freeCredits   Int         @default(10)
  lastResetDate DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  feedbacks     Feedback[]  @relation("UserToFeedback")
  userCredit    UserCredit? @relation("UserToUserCredit")
}

model UserCredit {
  id              String        @id @default(uuid())
  walletPublicKey String        @unique
  credits         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String?       @unique
  user            User?         @relation("UserToUserCredit", fields: [userId], references: [id])
  voteSessions    VoteSession[]
}

model PaymentLog {
  id              String   @id
  walletPublicKey String
  credits         Int
  solAmount       Float?
  otherAmount     Float?
  otherPayType    String?
  status          String
  error           String?
  createdAt       DateTime @default(now())
}

model ApiKey {
  id            String         @id @default(dbgenerated("uuid_generate_v4()"))
  name          String
  provider      String
  key           String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastUsed      DateTime?
  validatorKeys ValidatorKey[]

  @@index([provider, isActive])
}

model ValidatorKey {
  id          String    @id @default(uuid())
  validatorId String
  apiKeyId    String
  createdAt   DateTime  @default(now())
  apiKey      ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  validator   Validator @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([validatorId, apiKeyId])
}

model Validator {
  id            String              @id @default(uuid())
  profileName   String
  provider      String
  modelName     String
  publicKey     String
  isLeader      Boolean             @default(false)
  active        Boolean             @default(true)
  description   String?
  avatarUrl     String?
  validatorType String?
  reliability   Float?              @default(0.0)
  totalVotes    Int                 @default(0)
  correctVotes  Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  graphEdges    GraphEdge[]         @relation("ValidatorEdges")
  apiKeys       ValidatorKey[]
  responses     ValidatorResponse[]

  @@index([provider])
  @@index([active])
}

model VoteSession {
  id                 String              @id @default(uuid())
  queryText          String
  context            String?
  timestamp          DateTime            @default(now())
  isConsensusReached Boolean
  consensusValue     Boolean?
  votesYes           Int                 @default(0)
  votesNo            Int                 @default(0)
  notVoted           Int                 @default(0)
  leaderId           String?
  txHash             String?
  blockchainNetwork  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  mode               QueryMode?
  queryAiCountReq    Int?
  queryCost          Float?
  responseLatency    Int?
  statusProcessing   QueryStatus?
  userId             String?
  walletPublicKey    String?
  favorites          Favorite[]
  graphEdges         GraphEdge[]         @relation("VoteSessionEdges")
  threads            Thread[]
  validatorResponses ValidatorResponse[]
  user               UserCredit?         @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([consensusValue])
  @@index([isConsensusReached])
}

model ValidatorResponse {
  id                 String      @id @default(uuid())
  vote               String
  rationale          String
  confidence         Float?      @default(0.5)
  rationaleEmbedding String?
  latency            Int?
  matchedConsensus   Boolean?
  voteSessionId      String
  validatorId        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  error              String?
  validator          Validator   @relation(fields: [validatorId], references: [id], onDelete: Cascade)
  voteSession        VoteSession @relation(fields: [voteSessionId], references: [id])

  @@index([vote])
  @@index([voteSessionId])
  @@index([validatorId])
  @@index([matchedConsensus])
}

model GraphEdge {
  id            String       @id @default(uuid())
  sourceType    String
  targetType    String
  sourceId      String
  targetId      String
  relationship  String
  weight        Float?
  properties    String       @default("")
  createdAt     DateTime     @default(now())
  validatorId   String?
  voteSessionId String?
  validator     Validator?   @relation("ValidatorEdges", fields: [validatorId], references: [id], onDelete: Cascade)
  voteSession   VoteSession? @relation("VoteSessionEdges", fields: [voteSessionId], references: [id])

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationship])
}

model Thread {
  id            String      @id @default(uuid())
  title         String
  body          String
  upvotes       Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  voteSessionId String
  downvotes     Int         @default(0)
  replies       Reply[]
  voteSession   VoteSession @relation(fields: [voteSessionId], references: [id], onDelete: Cascade)
}

model Reply {
  id        String   @id @default(uuid())
  body      String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Feedback {
  id                 String   @id @default(uuid())
  userId             String
  username           String
  email              String
  rating             String   @default("thumbs_up")
  explanation        String?
  options            String[] @default([])
  includeBrowserInfo Boolean  @default(true)
  browserInfo        Json?
  url                String
  component          String
  action             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  title              String?
  user               User     @relation("UserToFeedback", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Favorite {
  id              String      @id @default(uuid()) @db.Uuid
  user_id         String      @db.Uuid
  vote_session_id String
  created_at      DateTime    @default(now()) @db.Timestamptz(3)
  favoriteType    String?
  title           String?
  vote_session    VoteSession @relation(fields: [vote_session_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vote_session_id])
  @@index([user_id])
}

model LLMHealthMetric {
  id               String          @id @default(uuid())
  providerName     String          @db.VarChar(50)
  modelName        String          @db.VarChar(100)
  status           LLMHealthStatus @default(healthy)
  errorRate        Decimal?        @db.Decimal(5, 2)
  avgLatency       Int?
  successRate      Decimal?        @db.Decimal(5, 2)
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  totalRequests    Int             @default(0)
  failedRequests   Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([providerName, modelName])
  @@index([providerName, modelName])
  @@index([status])
  @@index([createdAt])
}

model ModelDeprecationAlert {
  id                 String    @id @default(uuid())
  modelName          String    @db.VarChar(100)
  providerName       String    @db.VarChar(50)
  deprecatedAt       DateTime
  replacementModel   String?   @db.VarChar(100)
  alertSent          Boolean   @default(false)
  resolvedAt         DateTime?
  errorSample        String?
  affectedValidators Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([alertSent])
  @@index([resolvedAt])
  @@index([providerName, modelName])
}

model LLMHealthProbe {
  id             String   @id @default(uuid())
  providerName   String   @db.VarChar(50)
  modelName      String   @db.VarChar(100)
  probeType      String   @db.VarChar(50)
  success        Boolean
  responseTimeMs Int?
  errorMessage   String?
  httpStatus     Int?
  testedAt       DateTime @default(now())

  @@index([providerName, modelName])
  @@index([testedAt])
  @@index([success])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model credit_audit_log {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  operation      String
  credit_type    String
  amount         Int
  balance_before Int
  balance_after  Int
  reason         String?
  metadata       Json?     @default("{}")
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  created_by     String?   @db.Uuid
  ip_address     String?   @db.Inet
  user_agent     String?

  @@index([created_at], map: "idx_credit_audit_created_at")
  @@index([operation], map: "idx_credit_audit_operation")
  @@index([user_id], map: "idx_credit_audit_user_id")
}

enum QueryMode {
  factCheck
  create
  predict
  shop
}

enum QueryStatus {
  Pending
  Voting
  Completed
  Failed
}

enum LLMHealthStatus {
  healthy
  degraded
  deprecated
  offline
}
