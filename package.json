{
  "name": "testnet-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:migrate": "node scripts/setup-database-url.js && prisma generate && prisma migrate deploy && next build",
    "build:safe": "prisma generate && next build",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "qa": "ts-node --project tsconfig.scripts.json test/test-qa.ts",
    "test:cache": "ts-node --project tsconfig.scripts.json scripts/test-validator-cache.ts",
    "benchmark:cache": "ts-node --project tsconfig.scripts.json scripts/benchmark-validator-cache.ts",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json,md}\"",
    "check-format": "prettier --check \"**/*.{js,ts,tsx,css,json,md}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "build:services": "tsc -p tsconfig.services.json",
    "build:all": "npm run build && npm run build:services",
    "ready": "npx tsc --noEmit && npm run build",
    "reset": "rm -rf .next/* && npm run dev",
    "postinstall": "prisma generate",
    "rls:audit": "ts-node --project tsconfig.scripts.json scripts/run-rls-audit.ts",
    "rls:test": "ts-node --project tsconfig.scripts.json scripts/test-rls-implementation.ts",
    "rls:analyze": "ts-node --project tsconfig.scripts.json scripts/analyze-db-operations.ts",
    "diagnose:vercel": "ts-node --project tsconfig.scripts.json scripts/diagnose-vercel-apis.ts",
    "test:api": "ts-node --project tsconfig.scripts.json scripts/test-api-routes.ts"
  },
