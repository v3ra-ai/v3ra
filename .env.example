# Supabase Configuration
# For Vercel deployment with Supabase integration, these are provided automatically:
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database URLs (Vercel provides these through Supabase integration)
DATABASE_URL=your-database-url
POSTGRES_PRISMA_URL=your-pooled-database-url
POSTGRES_URL_NON_POOLING=your-non-pooled-database-url

# For local development, you can also use the traditional NEXT_PUBLIC_ prefixes:
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL Configuration (optional - automatically detected on Vercel)
# Set this if you need to override the automatic URL detection
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================================================
# NEW ENVIRONMENT VARIABLES FOR DAILY CREDIT ALLOCATION SYSTEM
# ============================================================================

# REQUIRED: Cron Job Security
# Generate with: openssl rand -base64 32
# Used to secure the daily credit allocation cron endpoint
CRON_SECRET=your-secure-random-string-here

# OPTIONAL: Credit System Configuration
MAX_FREE_CREDITS=10

# OPTIONAL: Admin API Access (for programmatic admin operations)
ADMIN_API_KEY=your-admin-api-key

# OPTIONAL: API Key Encryption (for storing provider API keys)
# If not set, defaults will be used (not recommended for production)
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_IV=your-16-char-iv

# ============================================================================
# TRACKING AND FEEDBACK SYSTEM
# ============================================================================

# Hotjar Integration (Production only)
# Get your Hotjar ID from: https://insights.hotjar.com/site/list
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-site-id

# Slack Feedback Webhook
# Create incoming webhook at: https://api.slack.com/apps
SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Sentry DSN (Already configured)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ============================================================================
# SETUP INSTRUCTIONS FOR DAILY CREDIT SYSTEM:
# ============================================================================
# 1. Generate CRON_SECRET: openssl rand -base64 32
# 2. Set in production (Vercel): Add to Environment Variables
# 3. Apply database migration: npx supabase db push
# 4. Deploy - cron will start automatically at midnight UTC
# 5. Monitor at: /admin (import CreditAllocationMonitor component)
# ============================================================================